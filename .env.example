# ==============================================================================
# Revix Environment Configuration (Palantir-Grade Standard)
# ==============================================================================
# Copy this file to .env and configure your environment.
# ==============================================================================

# === REQUIRED SETTINGS ===

# --- AI CONFIGURATION (Provider-Agnostic, LiteLLM Standard) ---
# Any LiteLLM-compatible model string works here.
#
# Examples:
#   OpenRouter:  openrouter/anthropic/claude-3.7-sonnet
#                openrouter/deepseek/deepseek-r1
#                openrouter/meta-llama/llama-3.3-70b-instruct
#   Anthropic:   anthropic/claude-3-5-sonnet-20241022
#   OpenAI:      gpt-4o  (or gpt-4o-mini)
#   Ollama:      openai/deepseek-r1:32b  (with AI_API_BASE=http://localhost:11434/v1)
#   vLLM:        hosted_vllm/your-model  (with AI_API_BASE=http://localhost:8000/v1)

AI_API_KEY=sk-or-v1-your-api-key-here
AI_MODEL_MAP=openrouter/google/gemini-3.1-flash-lite
AI_MODEL_REDUCE=openrouter/google/gemini-3.1-flash-lite
# AI_API_BASE=http://localhost:11434/v1
# AI_FALLBACK_MODELS=["openrouter/anthropic/claude-3.5-haiku"]
AI_CONCURRENCY=5

# --- REVIEW BUDGET & QUALITY GATES ---
REVIEW_PROFILE=chill
REVIEW_MAX_CHUNKS=12
REVIEW_MAX_AGENTS_PER_CHUNK=2
REVIEW_MAX_INLINE_COMMENTS=8
REVIEW_MIN_INLINE_SEVERITY=WARNING

# --- GITHUB APP AUTHENTICATION ---
# Create your app at: https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Private key can be provided in three ways:
# 1. File path (zero friction, auto-detects ./github_private_key.pem if present):
GITHUB_APP_PRIVATE_KEY_PATH=./github_private_key.pem
# 2. Base64 encoded string (recommended for 12-factor cloud / K8s secrets):
# GITHUB_APP_PRIVATE_KEY_B64=your_base64_encoded_key_here
# 3. Raw PEM string:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

GITHUB_BOT_NAME=revix

# --- DATABASE ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revix
DB_POOL_MIN_SIZE=10

# === OPTIONAL SETTINGS ===
PROJECT_NAME=Revix
DEBUG=False

# --- WORKER & RELIABILITY ---
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_TIMEOUT=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_SECONDS=90
WORKER_RECONCILE_INTERVAL_SECONDS=60
WORKER_RETRY_BACKOFF_SECONDS=120

# --- OBSERVABILITY ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- TUNNELING (For local webhook testing) ---
# NGROK_AUTHTOKEN=your_ngrok_token_here

