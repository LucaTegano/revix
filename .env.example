# ==============================================================================
# Revixl Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# ==============================================================================

# === REQUIRED SETTINGS ===
# These must be set for the application to start.

# --- AI CONFIGURATION ---
AI_API_KEY=sk-or-v1-your-key-here

# Models (LiteLLM format: provider/model)
AI_MODEL_MAP=openrouter/google/gemini-2.0-flash-lite:free
AI_MODEL_REDUCE=openrouter/anthropic/claude-3.5-sonnet

# Optional Fallbacks (Used if primary provider is offline)
# AI_FALLBACK_MODELS=["gemini/gemini-1.5-flash"]

# --- GITHUB APP ---
# Create your app at: https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret
# Base64 encoded GitHub App private key
# Generate via: cat github_private_key.pem | base64
GITHUB_APP_PRIVATE_KEY_B64=your_base64_encoded_key_here

# --- DATABASE ---
# Format: postgresql://user:password@host:port/dbname
# If using 'make db', the default below works for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revix

# === OPTIONAL SETTINGS (Sane Defaults) ===

# --- PROJECT ---
PROJECT_NAME=Revix
DEBUG=False

# --- WORKER & RELIABILITY ---
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_TIMEOUT=30
GITHUB_BOT_NAME=revix

# --- OBSERVABILITY ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- TUNNELING (For local webhook testing) ---
NGROK_AUTHTOKEN=your_ngrok_token_here

